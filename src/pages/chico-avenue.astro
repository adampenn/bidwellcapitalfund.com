  .levers { background: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius-lg); padding: 1.25rem 1.25rem 0.5rem; }
  @media (min-width: 961px) and (min-height: 1150px) { .levers { position: sticky; top: 5.25rem; } }
  .lever-group { padding-bottom: 1rem; margin-bottom: 1rem; border-bottom: 1px solid var(--border); }
  .lever-group:last-child { border-bottom: 0; }
  .lever-row-head { display: flex; justify-content: space-between; align-items: baseline; }
  .lever-title { display: block; font-size: 0.72rem; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: var(--text-tertiary); margin-bottom: 0.6rem; }
  .lever-note, .lever-hint { font-size: 0.78rem; color: var(--text-secondary); line-height: 1.45; margin-top: 0.4rem; }
  .lever { margin-bottom: 1.1rem; }
  .lever.dim { opacity: 0.4; pointer-events: none; }
  .lever-label { display: flex; justify-content: space-between; align-items: baseline; font-size: 0.88rem; margin-bottom: 0.2rem; gap: 0.5rem; }
  .lever-label span { color: var(--text-primary); }
  .lever-label output { font-weight: 600; color: var(--text-primary); font-variant-numeric: tabular-nums; white-space: nowrap; text-align: right; }
  input[type=range] { width: 100%; -webkit-appearance: none; appearance: none; height: 28px; background: transparent; outline: none; margin: 0; cursor: pointer; }
  input[type=range]::-webkit-slider-runnable-track { height: 4px; background: var(--border-strong); border-radius: 2px; }
  input[type=range]::-moz-range-track { height: 4px; background: var(--border-strong); border-radius: 2px; }
  input[type=range]::-webkit-slider-thumb { -webkit-appearance: none; width: 22px; height: 22px; margin-top: -9px; border-radius: 50%; background: var(--accent); border: 2px solid var(--bg-card); box-shadow: 0 1px 4px rgba(0,0,0,0.25); }
  input[type=range]::-moz-range-thumb { width: 22px; height: 22px; border-radius: 50%; background: var(--accent); border: 2px solid var(--bg-card); }
  input[type=range]:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; border-radius: 4px; }
  .seg { display: flex; background: var(--bg); border: 1px solid var(--border); border-radius: 999px; padding: 3px; gap: 2px; }
  #presets button { flex: 0 1 auto; padding-left: 0.7rem; padding-right: 0.7rem; }
  .lbl-short { display: none; }
  @media (max-width: 420px) { .lbl-long { display: none; } .lbl-short { display: inline; } #presets button { padding-left: 0.5rem; padding-right: 0.5rem; } }
