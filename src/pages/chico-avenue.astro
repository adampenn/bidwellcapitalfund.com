<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.js"></script>
<script is:inline>
(function () {
  var ACCESS_HASH = 'bb085e044524bc51921d4ffd253e8618963fa59c10973d412d6a6a5d6711c177';
  var M = window.CAP_MODEL;
  var MIN_INVEST = 50000;

  /* ---------- formatting ---------- */
  function money(n, opts) {
    opts = opts || {};
    var neg = n < 0; n = Math.abs(n);
    var s;
    if (opts.compact && n >= 999500) s = '$' + (n / 1000000).toFixed(2).replace(/\.?0+$/, '') + 'M';
    else if (opts.compact && n >= 9500) s = '$' + Math.round(n / 1000) + 'K';
    else s = '$' + Math.round(n).toLocaleString('en-US');
    return (neg ? '−' : '') + s;
  }
  function pct(x, d) { if (x === null || x === undefined || isNaN(x)) return 'n/a'; return (x * 100).toFixed(d === undefined ? 1 : d) + '%'; }
  function parseMoney(s) {
    s = String(s).trim().toLowerCase().replace(/[$,\s]/g, '');
    var mult = 1;
    if (/k$/.test(s)) { mult = 1000; s = s.slice(0, -1); }
    else if (/m$/.test(s)) { mult = 1000000; s = s.slice(0, -1); }
    var n = parseFloat(s);
    return isNaN(n) ? 0 : n * mult;
  }

  /* ---------- state ---------- */
  var PRESETS = {
    base: {},
    down: { rentAdj: -0.05, stabilizeYears: 4, rentGrowth: 0.025, vacancy: 0.06, expGrowth: 0.03, capRate: 0.07, rateDelta: 0.005, refiRate: 0.07, refiLTV: 0.60, rehabOverrun: 0.15 },
    up:   { rentAdj: 0.05, stabilizeYears: 2, rentGrowth: 0.035, vacancy: 0.03, expGrowth: 0.025, capRate: 0.06, rateDelta: -0.0025, refiRate: 0.06, refiLTV: 0.65, rehabOverrun: 0 }
  };
  var state = { selection: 'both', investment: 100000 };
  var levers = ['rentAdj', 'stabilizeYears', 'rentGrowth', 'vacancy', 'expGrowth', 'rehabOverrun', 'capRate', 'rateDelta', 'refiRate', 'refiLTV', 'refiOn', 'refi2On', 'hold'];
  var inputs = {
    rentAdj: { el: 'inp-rentAdj', out: 'out-rentAdj', scale: 100, fmt: function (v) { return (v > 0 ? '+' : '') + (v * 100).toFixed(1).replace(/\.0$/, '') + '%'; } },
    stabilizeYears: { el: 'inp-stab', out: 'out-stab', scale: 1, fmt: function (v) { return v + ' years (year ' + (v + 1) + ')'; } },
    rentGrowth: { el: 'inp-rentGrowth', out: 'out-rentGrowth', scale: 100, fmt: function (v) { return (v * 100).toFixed(2).replace(/0$/, '') + '%'; } },
    vacancy: { el: 'inp-vacancy', out: 'out-vacancy', scale: 100, fmt: function (v) { return (v * 100).toFixed(1) + '%'; } },
    expGrowth: { el: 'inp-expGrowth', out: 'out-expGrowth', scale: 100, fmt: function (v) { return (v * 100).toFixed(2).replace(/0$/, '') + '%'; } },
    rehabOverrun: { el: 'inp-rehab', out: 'out-rehab', scale: 100, fmt: function (v) { return v ? '+' + Math.round(v * 100) + '% over plan' : 'On plan'; } },
    capRate: { el: 'inp-capRate', out: 'out-capRate', scale: 100, fmt: function (v) { return (v * 100).toFixed(2) + '%'; } },
    rateDelta: { el: 'inp-rateDelta', out: 'out-rateDelta', scale: 100, fmt: function (v) { return '1017 ' + ((M.PROPERTIES.p1017.rate + v) * 100).toFixed(2) + '% · Royal Arms ' + ((M.PROPERTIES.ra.rate + v) * 100).toFixed(2) + '%'; } },
    refiRate: { el: 'inp-refiRate', out: 'out-refiRate', scale: 100, fmt: function (v) { return (v * 100).toFixed(2) + '%'; } },
    refiLTV: { el: 'inp-refiLTV', out: 'out-refiLTV', scale: 100, fmt: function (v) { return Math.round(v * 100) + '%'; } },
    hold: { el: 'inp-hold', out: 'out-hold', scale: 1, fmt: function (v) { return v + ' years'; } }
  };
  var toggles = { refiOn: 'inp-refiOn', refi2On: 'inp-refi2On' };

  function readLevers() {
    var A = {};
    for (var k in inputs) {
      var cfg = inputs[k];
      var raw = parseFloat(document.getElementById(cfg.el).value);
      A[k] = cfg.scale === 1 ? Math.round(raw) : raw / cfg.scale;
      document.getElementById(cfg.out).textContent = cfg.fmt(A[k]);
    }
    for (var t in toggles) A[t] = document.getElementById(toggles[t]).checked;
    document.getElementById('lever-refiRate').classList.toggle('dim', false);
    document.getElementById('lever-refiLTV').classList.toggle('dim', !A.refiOn);
    document.getElementById('lever-refi2').classList.toggle('dim', !A.refiOn);
    return A;
  }
  function writeLevers(A) {
    for (var k in inputs) {
      if (A[k] === undefined) continue;
      var cfg = inputs[k];
      document.getElementById(cfg.el).value = cfg.scale === 1 ? A[k] : +(A[k] * cfg.scale).toFixed(4);
    }
    for (var t in toggles) if (A[t] !== undefined) document.getElementById(toggles[t]).checked = A[t];
  }
  function applyPreset(name) {
    var A = {};
    for (var k in M.UNDERWRITING) A[k] = M.UNDERWRITING[k];
    var p = PRESETS[name] || {};
    for (var k2 in p) A[k2] = p[k2];
    writeLevers(A);
    markPreset(name);
    update();
  }
  function markPreset(name) {
    var btns = document.querySelectorAll('#presets button');
    for (var i = 0; i < btns.length; i++) {
      var id = btns[i].getAttribute('data-preset');
      btns[i].classList.toggle('active', id === (name || 'custom'));
      if (id === 'custom') btns[i].hidden = !!name;
    }
  }

  /* ---------- rendering ---------- */
  var chart = null;
  function cssVar(n) { return getComputedStyle(document.documentElement).getPropertyValue(n).trim(); }

  function kpi(label, value, sub, delta, colored) {
    var d = '';
    if (delta) d = '<span class="kpi-delta ' + (colored ? delta.cls : 'flat') + '">' + delta.text + '</span>';
    return '<div class="kpi"><span class="kpi-label">' + label + '</span><b class="kpi-value">' + value + '</b><span class="kpi-sub">' + (sub || '') + d + '</span></div>';
  }
  function deltaPct(cur, base, d) {
    if (cur === null || base === null || cur === undefined || base === undefined) return null;
    var diff = (cur - base) * 100;
    if (Math.abs(diff) < 0.05) return { cls: 'flat', text: 'same as underwriting' };
    return { cls: diff > 0 ? 'up' : 'down', text: (diff > 0 ? '+' : '−') + Math.abs(diff).toFixed(d === undefined ? 1 : d) + ' pts vs. underwriting' };
  }
  function deltaX(cur, base) {
    var diff = cur - base;
    if (Math.abs(diff) < 0.005) return { cls: 'flat', text: 'same as underwriting' };
    return { cls: diff > 0 ? 'up' : 'down', text: (diff > 0 ? '+' : '−') + Math.abs(diff).toFixed(2) + 'x vs. underwriting' };
  }
  function deltaMoney(cur, base) {
    var diff = cur - base;
    if (Math.abs(diff) < 50) return { cls: 'flat', text: 'same as underwriting' };
    return { cls: diff > 0 ? 'up' : 'down', text: (diff > 0 ? '+' : '−') + money(Math.abs(diff)) + ' vs. underwriting' };
  }

  function update() {
    var A = readLevers();
    var res = M.runPortfolio(state.selection, A);
    var base = M.runPortfolio(state.selection, { hold: A.hold });
    var N = A.hold;

    /* Investment: clamp to the raise and show why */
    var invEl = document.getElementById('inp-invest');
    var requested = state.investment;
    var inv = Math.min(requested, res.equity);
    var share = res.equity > 0 ? inv / res.equity : 0;
    var note = document.getElementById('invest-note');
    if (requested > res.equity) note.textContent = 'The whole raise for this selection is ' + money(res.equity) + ', so figures are shown at that amount.';
    else if (requested < 100000) note.textContent = '$100,000 minimum; the Manager may accept less. Figures shown at ' + money(inv) + '.';
    else note.textContent = pct(share, 2) + ' of the ' + money(res.equity) + ' raise.';

    /* KPIs */
    var totalOnInv = res.totalDistributions * share;
    var cashOnInv = 0, refiOnInv = 0, callOnInv = 0;
    res.years.forEach(function (r) { cashOnInv += r.lpCash * share; refiOnInv += r.lpRefi * share; callOnInv += r.deficit * share; });
    var saleOnInv = res.saleProceedsLP * share;
    var html = '';
    html += kpi('Total back on ' + money(inv), money(totalOnInv), res.multiple.toFixed(2) + 'x your investment over ' + N + ' years', deltaX(res.multiple, base.multiple), true);
    html += kpi(N + '-year annual return (IRR)', pct(res.irr), 'after our fees and our 20%, before your taxes', deltaPct(res.irr, base.irr), true);
    html += kpi('Year 1 cash yield', pct(res.y1Coc), money(res.years[0].lpCash * share) + ' in year 1', deltaPct(res.y1Coc, base.y1Coc), false);
    html += kpi('Average cash yield', pct(res.avgCoc), 'a year on your original ' + money(inv) + ', years 1 to ' + N + ' (' + money(cashOnInv) + ' total)', deltaPct(res.avgCoc, base.avgCoc), false);
    var refiSub = money(refiOnInv) + ' of your ' + money(inv);
    var lastRefiYear = 0; res.years.forEach(function (r) { if (r.roc > 0) lastRefiYear = r.year; });
    if (res.refiRocPct > 0) refiSub += ': ' + pct(res.refiRocBy5Pct, 0) + ' by year 5' + (lastRefiYear > 5 && res.refiRocPct > res.refiRocBy5Pct + 0.005 ? ', ' + pct(res.refiRocPct, 0) + ' by year ' + lastRefiYear : '');
    html += kpi('Returned by refinance', pct(res.refiRocPct, 0), refiSub, deltaPct(res.refiRocPct, base.refiRocPct, 0), false);
    html += kpi('Your share of the sale, year ' + N, money(saleOnInv), 'on top of ' + money(refiOnInv) + ' from refinances and ' + money(cashOnInv) + ' of cash flow, at a ' + pct(A.capRate, 2) + ' cap less 4% cost of sale', deltaMoney(saleOnInv, base.saleProceedsLP * share), false);
    document.getElementById('kpis').innerHTML = html;
    document.getElementById('mini-kpis').innerHTML =
      '<div><b>' + money(totalOnInv) + '</b><span>back on ' + money(inv) + ' · ' + res.multiple.toFixed(2) + 'x</span></div>' +
      '<div><b>' + pct(res.irr) + '</b><span>' + N + '-year IRR</span></div>';

    /* Events and warnings */
    var ev = [];
    if (callOnInv > 0) ev.push('<li class="warn"><b>Capital call.</b> Operating shortfalls total ' + money(res.deficits) + ' across the portfolio (' + money(callOnInv) + ' of your share), shown as negative bars and deducted from the returns.</li>');
    if (res.minDscr !== null && res.minDscr < 1.25) ev.push('<li class="warn"><b>Coverage below 1.25x.</b> The lowest year runs at ' + res.minDscr.toFixed(2) + 'x, which would breach a typical loan covenant.</li>');
    res.years.forEach(function (r) { r.events.forEach(function (e) { if (e.indexOf(': Refinance') !== -1 && e.indexOf('sized by coverage') === -1 && e.indexOf('skipped') === -1) return; ev.push('<li>Year ' + r.year + ': ' + e + '.</li>'); }); });
    var evEl = document.getElementById('events');
    evEl.innerHTML = ev.length ? '<span class="section-label">What happens in this scenario</span><ul>' + ev.join('') + '</ul>' : '';
    evEl.hidden = !ev.length;

    /* Chart */
    var labels = [], cash = [], refi = [], sale = [], call = [], invLine = [];
    var cCash = 0, cRefi = 0, cSale = 0, cCall = 0;
    res.years.forEach(function (r) {
      labels.push('Yr ' + r.year);
      cCash += r.lpCash * share; cRefi += r.lpRefi * share; cSale += r.lpSale * share; cCall += r.deficit * share;
      cash.push(Math.round(cCash));
      refi.push(Math.round(cRefi));
      sale.push(Math.round(cSale));
      call.push(-Math.round(cCall));
      invLine.push(Math.round(inv));
    });
    var hasCall = callOnInv > 0;
    document.getElementById('legend-call').hidden = !hasCall;
    var ink = cssVar('--text-secondary'), grid = cssVar('--border');
    var ds = [
      { label: 'Cash flow', data: cash, backgroundColor: cssVar('--c-cash'), stack: 'a', borderRadius: 3 },
      { label: 'Refinance proceeds', data: refi, backgroundColor: cssVar('--c-refi'), stack: 'a', borderRadius: 3 },
      { label: 'Sale proceeds', data: sale, backgroundColor: cssVar('--c-sale'), stack: 'a', borderRadius: 3 }
    ];
    if (hasCall) ds.push({ label: 'Capital call', data: call, backgroundColor: cssVar('--c-call'), stack: 'a', borderRadius: 3 });
    ds.push({ type: 'line', label: 'Your ' + money(inv), data: invLine, borderColor: cssVar('--text-secondary'), borderWidth: 1.5, borderDash: [6, 4], pointRadius: 0, fill: false, order: -1 });
    if (!chart) {
      chart = new Chart(document.getElementById('chart-dist'), {
        type: 'bar',
        data: { labels: labels, datasets: ds },
        options: {
          responsive: true, maintainAspectRatio: false, animation: { duration: 250 },
          interaction: { mode: 'index', intersect: false },
          plugins: {
            legend: { display: false },
            tooltip: { callbacks: { label: function (c) { return c.dataset.label + ': ' + money(c.parsed.y); },
              footer: function (items) { var t = 0; items.forEach(function (i) { if (i.dataset.type !== 'line') t += i.parsed.y; }); return 'Total so far: ' + money(t); } } }
          },
          scales: {
            x: { stacked: true, grid: { display: false }, ticks: { color: ink, font: { family: 'DM Sans' }, maxRotation: 0 } },
            y: { stacked: true, grid: { color: grid }, ticks: { color: ink, font: { family: 'DM Sans' }, callback: function (v) { return money(v, { compact: true }); } } }
          }
        }
      });
    } else {
      chart.data.labels = labels;
      chart.data.datasets = ds;
      chart.update();
    }

    /* Table: investor columns first */
    var t = '<thead><tr><th>Year</th><th>Cash flow</th><th>Refinance</th><th class="scol">Sale</th>' + (hasCall ? '<th>Capital call</th>' : '') + '<th>Total</th><th class="ycol">Cash yield</th><th class="pfcol">Portfolio NOI</th><th class="pfcol">Loan payments</th><th class="pfcol">Coverage</th></tr></thead><tbody>';
    res.years.forEach(function (r) {
      var c = r.lpCash * share, rf = r.lpRefi * share, s = r.lpSale * share, d = r.deficit * share;
      var cov = r.dscr === null ? 'n/a' : r.dscr.toFixed(2) + 'x';
      t += '<tr' + (r.year === N ? ' class="last"' : '') + '><th scope="row">' + r.year + '</th><td>' + money(c) + '</td><td>' + (rf ? money(rf) : '–') + '</td><td class="scol">' + (s ? money(s) : '–') + '</td>' +
        (hasCall ? '<td>' + (d ? money(-d) : '–') + '</td>' : '') +
        '<td><b>' + money(c + rf + s - d) + '</b></td><td class="ycol">' + pct(r.cocOnEquity) + '</td><td class="pfcol">' + money(r.noi) + '</td><td class="pfcol">' + money(r.debtService) + '</td><td class="pfcol' + (r.dscr !== null && r.dscr < 1.25 ? ' low' : '') + '">' + cov + '</td></tr>';
    });
    t += '</tbody><tfoot><tr><th scope="row">Total</th><td>' + money(cashOnInv) + '</td><td>' + money(refiOnInv) + '</td><td class="scol">' + money(saleOnInv) + '</td>' + (hasCall ? '<td>' + money(-callOnInv) + '</td>' : '') + '<td><b>' + money(totalOnInv) + '</b></td><td class="ycol"></td><td class="pfcol" colspan="3"></td></tr></tfoot>';
    document.getElementById('table-years').innerHTML = t;
    document.getElementById('table-note').innerHTML = 'Your share (' + pct(share, 2) + ' of the ' + money(res.equity) + ' raise).<span class="pfcol"> The last three columns are for all ' + res.units + ' units.</span><span class="mobile-only"> Sale proceeds are inside the final year\'s total. Cash yield, building NOI and loan coverage show on a larger screen.</span>';

    /* Sources and uses */
    var price = 0, credit = 0, rehab = 0, closing = 0, reserves = 0, fee = 0;
    res.properties.forEach(function (p) { price += p.uses.price; credit += p.uses.sellerCredit; rehab += p.uses.rehab; closing += p.uses.closingCosts; reserves += p.uses.reserves; fee += p.uses.acqFee; });
    var su = '<tr><th colspan="2">Uses</th></tr>';
    su += '<tr><td>Purchase price, contract</td><td>' + money(price) + '</td></tr>';
    su += '<tr><td>Seller repair credits</td><td>' + money(-credit) + '</td></tr>';
    su += '<tr><td>Renovation' + (A.rehabOverrun ? ' (+' + Math.round(A.rehabOverrun * 100) + '%)' : '') + '</td><td>' + money(rehab) + '</td></tr>';
    su += '<tr><td>Closing costs</td><td>' + money(closing) + '</td></tr>';
    su += '<tr><td>Operating reserves</td><td>' + money(reserves) + '</td></tr>';
    su += '<tr><td>Acquisition fee, 2% of contract</td><td>' + money(fee) + '</td></tr>';
    su += '<tr class="sum"><td>Total</td><td>' + money(res.totalCost) + '</td></tr>';
    su += '<tr><th colspan="2">Sources</th></tr>';
    su += '<tr><td>Purchase loans</td><td>' + money(res.totalLoan) + '</td></tr>';
    su += '<tr><td>Investor equity, whole raise</td><td>' + money(res.equity) + '</td></tr>';
    su += '<tr><td>Your share at ' + money(inv) + '</td><td>' + pct(share, 2) + '</td></tr>';
    su += '<tr class="sum"><td>Basis per door, net of credits</td><td>' + money((price - credit) / res.units) + '</td></tr>';
    su += '<tr class="sum"><td>Stabilized return on cost<sup>†</sup></td><td>' + pct(res.yieldOnCost) + '</td></tr>';
    su += '<tr><td colspan="2" class="foot">†Year ' + (Math.max(2, Math.round(A.stabilizeYears)) + 1) + ' NOI divided by net price, renovation and acquisition fee. Offering and organizational expenses are not included above.</td></tr>';
    document.getElementById('table-su').innerHTML = su;

    /* What Bidwell earns */
    var g = res.gp;
    var gpT = '<tr><th colspan="2">Over ' + N + ' years, base on these levers</th></tr>';
    gpT += '<tr><td>Acquisition fee at closing</td><td>' + money(g.acqFee) + '</td></tr>';
    gpT += '<tr><td>Property management, 5.5% of collections</td><td>' + money(g.pmFee) + '</td></tr>';
    gpT += '<tr><td>Asset management, 1% of revenues</td><td>' + money(g.amFee) + '</td></tr>';
    gpT += '<tr><td>Refinance and guaranty fees</td><td>' + money(g.refiFee) + '</td></tr>';
    gpT += '<tr><td>20% share of cash flow</td><td>' + money(g.promoteCash) + '</td></tr>';
    gpT += '<tr><td>20% share of sale profit</td><td>' + money(g.promoteSale) + '</td></tr>';
    gpT += '<tr class="sum"><td>Total to the Manager</td><td>' + money(g.total) + '</td></tr>';
    gpT += '<tr class="sum"><td>Total profit to investors</td><td>' + money(res.lpProfit) + '</td></tr>';
    document.getElementById('table-gp').innerHTML = gpT;

    /* Rent hint */
    var hint = res.properties.map(function (p) {
      var P = M.PROPERTIES[p.id];
      var avg = P.rentTarget * (1 + A.rentAdj) / P.units / 12;
      return P.name + ' ' + money(avg);
    }).join(', ');
    var today = res.properties.map(function (p) { var P = M.PROPERTIES[p.id]; return P.name + ' ' + money(P.rentCurrent / P.units / 12); }).join(', ');
    document.getElementById('hint-rentAdj').textContent = 'Year 3 average: ' + hint + '. Today: ' + today + '.';
  }

  function renderStatic() {
    var base = M.runPortfolio('both', {});
    document.getElementById('hero-irr').textContent = pct(base.irr);
    document.getElementById('hero-mult').textContent = base.multiple.toFixed(1) + 'x';
    document.getElementById('plan-lede').textContent = 'Combined, the two properties are underwritten at about ' + money(base.y1Noi, { compact: true }) + ' of year-1 net operating income (NOI, rent less operating costs). The plan takes that to about ' + money(base.stabNoi, { compact: true }) + ' by year 3 without betting on the market. Here is how.';
    var cap7 = M.runPortfolio('both', { capRate: 0.07 });
    document.getElementById('exit-cap-note').textContent = 'The base case assumes the sale cap rate equals today\'s 6.5%; at a 7.0% exit and refinance cap the projected IRR is about ' + pct(cap7.irr) + '.';
  }

  function renderProperties() {
    var photos = { p1017: '/chico-avenue/1017-esplanade.jpg', ra: '/chico-avenue/royal-arms.jpg' };
    var credits = { p1017: 'Photo: July 2026.', ra: 'Royal Arms, 1120 Esplanade.' };
    var html = '';
    ['p1017', 'ra'].forEach(function (id) {
      var P = M.PROPERTIES[id];
      var r = M.runProperty(P, M.UNDERWRITING);
      var y1 = r.years[0].noi, y3 = r.years[2].noi;
      var blurb = id === 'p1017'
        ? 'Twelve units, mostly two-bed two-baths, built 1973, with the cleanest inspection file in the estate. Contract price $1,450,000 with a $75,000 seller credit at closing. Year-1 pro forma NOI about ' + money(y1, { compact: true }) + ', about ' + money(y3, { compact: true }) + ' by year 3.'
        : 'Twenty-four units around a pool courtyard, built 1962, one block from 1017. Contract price $2,760,000 with a $154,000 seller credit negotiated against the roof; the seller\'s contractor issued a five-year roof certification, conditioned on minor repairs. Year-1 pro forma NOI about ' + money(y1, { compact: true }) + ', about ' + money(y3, { compact: true }) + ' by year 3. The on-site manager expense goes away day one.';
      var mix = '<table class="mix"><thead><tr><th>Type</th><th>Units</th><th>In place</th><th>Year 2</th><th>Target</th></tr></thead><tbody>';
      P.mix.forEach(function (u) { mix += '<tr><td>' + u.type + '</td><td>' + u.n + '</td><td>' + money(u.current) + '</td><td>' + money(u.market) + '</td><td>' + money(u.target) + '</td></tr>'; });
      mix += '<tr class="sum"><td>Average</td><td>' + P.units + '</td><td>' + money(P.rentCurrent / P.units / 12) + '</td><td>' + money(P.rentMarket / P.units / 12) + '</td><td>' + money(P.rentTarget / P.units / 12) + '</td></tr></tbody></table>';
      html += '<article class="prop card">' +
        '<div class="prop-photo"><img src="' + photos[id] + '" alt="' + P.name + '" loading="lazy" /><span class="photo-credit">' + credits[id] + '</span></div>' +
        '<div class="prop-body">' +
        '<h3>' + P.name + '</h3><p class="prop-alias">' + (id === 'p1017' ? 'Also known as Palm Manor' : '1120 Esplanade') + ' · ' + P.units + ' units · built ' + P.built + '</p>' +
        '<p>' + blurb + '</p>' +
        '<div class="prop-stats">' +
        '<div><b>' + money((P.price - P.sellerCredit) / P.units, { compact: true }) + '</b><span>per door, net</span></div>' +
        '<div><b>' + money(P.rehab / P.units, { compact: true }) + '</b><span>renovation per unit</span></div>' +
        '<div><b>' + money(r.equity, { compact: true }) + '</b><span>investor equity</span></div>' +
        '<div><b>' + pct(r.irr) + '</b><span>projected 10-yr IRR, base</span></div>' +
        '</div>' + mix +
        '<p class="fine">Monthly rents per unit. In place: seller rent rolls, August 2026. Year 2: the underwriting models\' interim rents. ' + (id === 'ra' ? 'Royal Arms year-2 rents are the June 2026 third-party appraisal\'s market rents. ' : '1017 was not appraised; comparable market rent for its two-bed two-baths is about $1,400, and the underwriting steps to $1,300 in year 2 as a conservative interim. ') + 'Target: September 2026 comp set, assumed reached in year 3.</p>' +
        '</div></article>';
    });
    document.getElementById('props').innerHTML = html;
  }

  /* ---------- boot ---------- */
  var booted = false;
  function boot() {
    if (booted) return; booted = true;
    var isDark = document.documentElement.getAttribute('data-theme') !== 'light';
    document.documentElement.style.setProperty('--c-cash', cssVar('--accent'));
    document.documentElement.style.setProperty('--c-refi', isDark ? '#7fa1c9' : '#4f78a8');
    document.documentElement.style.setProperty('--c-sale', isDark ? '#8fb096' : '#5f8a68');
    document.documentElement.style.setProperty('--c-call', isDark ? '#d47a6a' : '#b9463b');

    levers.forEach(function (k) {
      var cfg = inputs[k];
      var el = document.getElementById(cfg ? cfg.el : toggles[k]);
      var handler = function () { markPreset(null); update(); };
      el.addEventListener('input', handler);
      el.addEventListener('change', handler);
    });
    var inv = document.getElementById('inp-invest');
    function commitInvestment() {
      var n = Math.round(parseMoney(inv.value) / 1000) * 1000;
      if (!(n > 0)) n = 100000;
      n = Math.max(MIN_INVEST, n);
      state.investment = n;
      inv.value = n.toLocaleString('en-US');
      update();
    }
    inv.addEventListener('change', commitInvestment);
    inv.addEventListener('keydown', function (e) { if (e.key === 'Enter') { e.preventDefault(); inv.blur(); } });
    document.getElementById('btn-reset').addEventListener('click', function () { applyPreset('base'); });
    var pb = document.querySelectorAll('#presets button');
    for (var i = 0; i < pb.length; i++) pb[i].addEventListener('click', function () { var n = this.getAttribute('data-preset'); if (n !== 'custom') applyPreset(n); });
    var sb = document.querySelectorAll('#selection button');
    for (var j = 0; j < sb.length; j++) sb[j].addEventListener('click', function () {
      state.selection = this.getAttribute('data-sel');
      for (var k = 0; k < sb.length; k++) sb[k].classList.toggle('active', sb[k] === this);
      update();
    });
    var copyBtn = document.getElementById('btn-copy-email');
    copyBtn.addEventListener('click', function () {
      var email = copyBtn.getAttribute('data-email');
      var done = function () { copyBtn.textContent = 'Copied ' + email; setTimeout(function () { copyBtn.textContent = 'Copy email address'; }, 2500); };
      if (navigator.clipboard && navigator.clipboard.writeText) navigator.clipboard.writeText(email).then(done, done); else done();
    });
    renderStatic();
    renderProperties();
    update();
  }

  /* ---------- auth (runs last so every declaration above exists) ---------- */
  var authScreen = document.getElementById('auth-screen');
  var authInput = document.getElementById('auth-input');
  var authError = document.getElementById('auth-error');
  var app = document.getElementById('app');

  function sha256(text) {
    var data = new TextEncoder().encode(text);
    return crypto.subtle.digest('SHA-256', data).then(function (buf) {
      return Array.prototype.map.call(new Uint8Array(buf), function (b) { return ('0' + b.toString(16)).slice(-2); }).join('');
    });
  }
  function show() {
    authScreen.hidden = true;
    app.hidden = false;
    boot();
  }
  function unlock() {
    var code = authInput.value.trim().toLowerCase();
    if (!code) { authInput.focus(); return; }
    if (!(window.crypto && crypto.subtle)) { authError.textContent = 'This browser cannot verify the code. Please open the page over https.'; return; }
    sha256(code).then(function (h) {
      if (h === ACCESS_HASH) {
        try { sessionStorage.setItem('chico_auth', '1'); } catch (e) {}
        show();
      } else {
        authError.textContent = 'That code did not match. Check your invitation, or contact the person who sent it.';
        authInput.value = '';
        authInput.focus();
      }
    });
  }
  document.getElementById('auth-btn').addEventListener('click', unlock);
  authInput.addEventListener('keydown', function (e) { if (e.key === 'Enter') unlock(); });
  var remembered = false;
  try { remembered = sessionStorage.getItem('chico_auth') === '1'; } catch (e) {}
  if (remembered) show(); else authInput.focus();
})();
</script>

<style is:global>
  @import '../styles/global.css';

  /* ---------- theme helpers ---------- */
