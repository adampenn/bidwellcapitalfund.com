  @media (max-width: 700px) { .hero-stats { grid-template-columns: repeat(2, 1fr); gap: 1.25rem 1.5rem; } .hero { min-height: 520px; } .hero-inner { padding-top: 3.5rem; } }

  /* ---------- blocks ---------- */
  .block { padding: 5rem 0; }
  @media (max-width: 700px) { .block { padding: 3.5rem 0; } }
  .block-alt { background: var(--bg-secondary); border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); }
