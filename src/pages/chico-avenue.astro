  .block-head p { font-size: 1.05rem; }
  .card { background: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius-lg); padding: 1.5rem; box-shadow: 0 1px 2px var(--card-shadow); min-width: 0; }
  .card h3 { font-size: 1.2rem; margin-bottom: 0.75rem; }
  .card .section-label { font-size: 0.72rem; margin-bottom: 0.5rem; }
