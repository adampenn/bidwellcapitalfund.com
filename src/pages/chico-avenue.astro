    .mini-kpis div { display: flex; flex-direction: column; min-width: 0; }
    .mini-kpis div:last-child { text-align: right; }
    .mini-kpis b { font-family: var(--font-display); font-weight: 400; font-size: 1.7rem; color: var(--text-primary); line-height: 1.1; white-space: nowrap; }
    .mini-kpis span { font-size: 0.74rem; color: var(--text-secondary); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; margin-top: 0.15rem; }
    .levers { order: -1; }
  }
  .kpis { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }
  @media (max-width: 640px) { .kpis { grid-template-columns: repeat(2, 1fr); gap: 0.75rem; } }
  .kpi { background: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius-lg); padding: 1.1rem 1.25rem; display: flex; flex-direction: column; gap: 0.15rem; min-width: 0; }
  .kpi:first-child { border-color: var(--accent); }
  .kpi-label { font-size: 0.72rem; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: var(--text-tertiary); }
  .kpi-value { font-family: var(--font-display); font-weight: 400; font-size: 2rem; color: var(--text-primary); line-height: 1.15; font-variant-numeric: tabular-nums; }
  .kpi-sub { font-size: 0.78rem; color: var(--text-secondary); line-height: 1.4; display: flex; flex-direction: column; }
  .kpi-delta { font-size: 0.72rem; font-weight: 500; }
  .kpi-delta.up { color: #4e8a5b; } .kpi-delta.down { color: #b9463b; } .kpi-delta.flat { color: var(--text-tertiary); }
  .events { background: var(--bg-card); border: 1px solid var(--border); border-left: 3px solid var(--accent); border-radius: var(--radius-lg); padding: 1rem 1.25rem; }
  .events ul { list-style: none; display: flex; flex-direction: column; gap: 0.35rem; }
  .events li { font-size: 0.85rem; color: var(--text-secondary); line-height: 1.5; }
  .events li.warn { color: var(--text-primary); }
